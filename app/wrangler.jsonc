{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "politiker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    }
  },
  "tail_consumers": [
    {
      "service": "politiker-log-archive"
    }
  ],
  // Exponera inte på *.workers.dev — appen nås bara via politiker.denied.se
  // (custom domain). Stänger workers.dev-attackytan (Security Center-fynd).
  "workers_dev": false,
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "routes": [
    {
      "pattern": "politiker.denied.se",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "politiker",
      "database_id": "e9ecf94f-fa71-4004-a5b8-f9317eb4d4e9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "23255cc6e67a4a19b19e5ea67a676b40"
    }
  ],
  // Appen är både producent och konsument av sändningskön sedan
  // politiker-sender slogs ihop hit. En kö tillåter exakt EN konsument,
  // så sender-Workern måste vara raderad innan den här konfigurationen
  // deployas — annars avvisar Cloudflare bindningen.
  "queues": {
    "producers": [
      {
        "queue": "politiker-send-jobs",
        "binding": "SEND_QUEUE"
      }
    ],
    "consumers": [
      {
        // max_retries höjt 3 -> 10: riktiga SMTP-fel ackas direkt (aldrig
        // retry, se send-queue.ts) så detta påverkar dem inte — det ger bara
        // extra marginal åt den sällsynta fallback-vägen där
        // waitForSendSlot() gett upp efter MAX_WAIT_MS och meddelandet
        // läggs tillbaka i kön för att vänta in en ledig rate-limit-token.
        "queue": "politiker-send-jobs",
        "max_batch_size": 10,
        "max_retries": 10,
        "max_concurrency": 5,
        "dead_letter_queue": "politiker-send-jobs-dlq"
      }
    ]
  },

  // Token bucket per mailkoppling, från f.d. sender-Workern. Klassen exporteras
  // från main (src/index.ts). Deklarativ exports ersätter den äldre v1-
  // migrationsposten och beskriver det aktuella DO-tillståndet direkt.
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "CredentialRateLimiter"
      }
    ]
  },
  "exports": {
    "CredentialRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // Cron-körningarna från f.d. politiker-campaign (UTC):
  //   05 monitor · 06 brevgenerering · 07 utskick · 08 bounce-sweep
  //   06:30 den 1:a i jan/apr/jul/okt: kvartalsbrevet
  "triggers": {
    "crons": [
      "0 5 * * *",
      "0 6 * * *",
      "0 7 * * *",
      "0 8 * * *",
      "30 6 1 1,4,7,10 *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "politiker-attachments"
    }
  ],
  // Nyhetsbrevets bekräftelsemail: Cloudflare Email Service (bindingen nedan)
  // -> Resend (RESEND_API_KEY) -> system-SMTP, i den ordningen.
  // Systemmailen (verifieringskod, lösenordsåterställning, feedback) går
  // Resend -> system-SMTP.
  // Cloudflare Email Service och system-SMTP skickar som noreply@denied.se;
  // adressen måste vara onboardad i Email Sending, annars avvisas
  // send_email-anropen. Resend-ledet skickar från noreply@send.denied.se —
  // den domänen är den som är verifierad på Resend-kontot.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@denied.se"]
    }
  ],
  "vars": {
    "SYSTEM_SMTP_HOST": "smtp.mail.me.com",
    "SYSTEM_SMTP_PORT": "587",
    "SYSTEM_SMTP_USER": "nils.anders.eriksson@icloud.com",
    // Maskingenererade systemmail — avsändaren är obevakad med flit. Måste vara
    // ett alias på iCloud-kontot i SYSTEM_SMTP_USER, annars nekas MAIL FROM i
    // SMTP-ledet.
    "SYSTEM_FROM_ADDRESS": "noreply@denied.se",
    "FEEDBACK_NOTIFY_EMAIL": "noreply@denied.se",
    "ERROR_FIXER_INBOX": "steedpower3@gmail.com",
    "OAUTH_GOOGLE_CLIENT_ID": "1051427827429-nu6si4bq993a4onm8spk7bf94gctgr18.apps.googleusercontent.com",
    "OAUTH_MICROSOFT_CLIENT_ID": "dd6d7bb1-3a2d-46ad-8d4f-12fe09691414",

    // Från f.d. politiker-campaign.
    "SENDER_NAME": "Anders Eriksson",
    "GITHUB_REPO": "blixten85/politiker"
  }
}
