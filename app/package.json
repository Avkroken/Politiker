{
  "name": "politiker-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote --config ../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../wrangler.jsonc --outdir dist",
    "versions:upload": "wrangler versions upload --config ../wrangler.jsonc --outdir dist",
    "secret:set-mail-key": "wrangler secret put MAIL_CRED_KEY --config ../wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "unpdf": "^1.8.1"
  }
}
