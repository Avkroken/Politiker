{
  "name": "politiker-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "validate": "wrangler types && tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy --outdir dist",
    "versions:upload": "wrangler versions upload --outdir dist",
    "secret:set-mail-key": "wrangler secret put MAIL_CRED_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "unpdf": "^1.8.1"
  }
}
