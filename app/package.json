{
  "name": "politiker-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "validate": "npm test && node --check public/app.js && node --check public/app-send.js && node --check public/app-settings.js && node --check public/app-admin.js && wrangler types && tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy --outdir dist",
    "versions:upload": "wrangler versions upload --outdir dist",
    "secret:set-mail-key": "wrangler secret put MAIL_CRED_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "mammoth": "^1.12.2",
    "unpdf": "^1.8.1"
  }
}
