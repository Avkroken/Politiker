{
  "name": "politiker-webapp-healthcheck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy --outdir dist",
    "versions:upload": "wrangler versions upload --outdir dist",
    "typecheck": "tsc --noEmit",
    "secret:set-cf-token": "wrangler secret put CF_API_TOKEN",
    "secret:set-resend": "wrangler secret put RESEND_API_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  }
}
