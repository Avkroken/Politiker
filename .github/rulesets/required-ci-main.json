{
  "name": "required-ci",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "Node.js CI / build (24.x)"
          },
          {
            "context": "Docker Image CI / build"
          },
          {
            "context": "Dependency review / dependency-review"
          }
        ]
      }
    }
  ]
}
