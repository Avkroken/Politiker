# Politikerkontakt — lokal konfiguration för infra-skript
# Kopiera till infra/.env eller kör: bash infra/configure.sh
# infra/.env är git-ignorerad och ska aldrig committas.

# Publik basadress. Tomt = setup.sh använder https://<worker>.workers.dev.
CUSTOM_DOMAIN=
APP_BASE_URL=

# Genereras automatiskt av configure.sh/setup.sh om tom.
MAIL_CRED_KEY=

# Systemmail: verifieringskoder, lösenordsåterställning och feedbacknotiser.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_FROM_ADDRESS=
FEEDBACK_NOTIFY_EMAIL=

# Valfri OAuth-inloggning. Client ID är publikt; Client Secret är hemligt.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Valfri bounce-processor. Gmail kräver normalt app-lösenord när 2FA används.
GMAIL_EMAIL=
GMAIL_PASSWORD=

# Valfria lokala administrationsverktyg. Behövs inte för vanlig setup,
# eftersom Wrangler-inloggningen sköter Cloudflare-provisioneringen.
CLOUDFLARE_API_TOKEN_POLITIKER=

# Valfri Microsoft Graph-management helper (infra/az-graph-api.sh).
AZURE_MGMT_TENANT_ID=
AZURE_MGMT_CLIENT_ID=
AZURE_MGMT_CLIENT_SECRET=
AZURE_POLITIKER_APP_OBJECT_ID=
