# politiker — lokal konfiguration för infra-skript
# Kopiera vid behov till infra/.env. infra/.env är git-ignorerad.
# Miljövariabler som redan är exporterade kan också användas av hjälpskripten.

# ── Egen domän ──────────────────────────────────────────────────────────────
CUSTOM_DOMAIN=

# ── Krypteringsnyckel ───────────────────────────────────────────────────────
# AES-nyckel för krypterade SMTP-lösenord och brevdata. Lämna TOM — genereras
# automatiskt av setup.sh vid första körningen.
MAIL_CRED_KEY=

# ── Systemmail (obligatoriskt) ──────────────────────────────────────────────
SYSTEM_SMTP_PASSWORD=

# ── Bounce-processor (valfritt) ─────────────────────────────────────────────
GMAIL_EMAIL=
GMAIL_PASSWORD=

# ── OAuth-inloggning (valfritt) ─────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Lokala infra-skript (valfritt) ──────────────────────────────────────────
CLOUDFLARE_API_TOKEN_POLITIKER=

# Microsoft Graph management helper
AZURE_MGMT_TENANT_ID=
AZURE_MGMT_CLIENT_ID=
AZURE_MGMT_CLIENT_SECRET=
AZURE_POLITIKER_APP_OBJECT_ID=
